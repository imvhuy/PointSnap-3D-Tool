{
  "manifest_version": 3,
  "name": "PointSnap cho CVAT",
  "short_name": "PointSnap",
  "version": "0.4.0",
  "description": "Hỗ trợ annotator gán cuboid 3D trên CVAT: mặt đất tham chiếu, kiểm tra box, sửa cả track có xem trước. Dữ liệu không rời CVAT.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PointSnap cho CVAT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "src/core.js",
        "src/cvat-dom.js",
        "src/cvat-api.js",
        "src/seed.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "src/cvat-dom.js",
        "src/annotator/box.js",
        "src/annotator/spatial-grid.js",
        "src/annotator/terrain.js",
        "src/annotator/guideline.js",
        "src/annotator/checks.js",
        "src/annotator/track-ops.js",
        "src/annotator/object-points.js",
        "src/annotator/cvat-adapter.js",
        "src/annotator/overlay.js",
        "src/annotator/cloud-colors.js",
        "src/annotator/panel.js",
        "src/annotator/annotator.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "src/annotator/settings-bridge.js",
        "src/panel-css.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
