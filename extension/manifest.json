{
  "manifest_version": 3,
  "name": "PointSnap cho CVAT",
  "short_name": "PointSnap",
  "version": "0.3.0",
  "description": "Sửa tay cuboid trong CVAT: thước 3D, đường gióng, tọa độ trực tiếp và kiểm lại lỗi, không tự sửa.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PointSnap cho CVAT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "src/core.js",
        "src/cvat-dom.js",
        "src/cvat-api.js",
        "src/seed.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "src/manual-geometry.js",
        "src/cvat-compat.js",
        "src/manual-overlay.js",
        "src/cvat-3d-hook.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "src/panel-css.js",
        "src/manual-controller.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/manual-geometry.js",
        "src/cvat-compat.js",
        "src/manual-overlay.js",
        "src/cvat-3d-hook.js"
      ],
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ]
    }
  ]
}
