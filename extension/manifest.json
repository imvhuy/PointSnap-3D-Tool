{
  "manifest_version": 3,
  "name": "PointSnap cho CVAT",
  "short_name": "PointSnap",
  "version": "0.6.0",
  "description": "Hỗ trợ annotator gán cuboid 3D trên CVAT, bảng ở side panel cạnh CVAT: mặt đất tham chiếu, kiểm tra box, sửa cả track. Dữ liệu không rời CVAT.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PointSnap cho CVAT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "sidepanel.html?popup=1"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "src/cvat-dom.js",
        "src/annotator/box.js",
        "src/annotator/spatial-grid.js",
        "src/annotator/terrain.js",
        "src/annotator/guideline.js",
        "src/annotator/checks.js",
        "src/annotator/track-ops.js",
        "src/annotator/object-points.js",
        "src/annotator/measure.js",
        "src/annotator/zip.js",
        "src/annotator/pcd.js",
        "src/annotator/cvat-adapter.js",
        "src/annotator/overlay.js",
        "src/annotator/cloud-colors.js",
        "src/annotator/panel.js",
        "src/annotator/spec-editor.js",
        "src/annotator/panel-link.js",
        "src/annotator/annotator.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "js": [
        "hosts.js",
        "src/annotator/settings-bridge.js",
        "src/annotator/panel-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Mở bảng PointSnap (side panel)"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "PointSnap",
    "default_icon": "icons/icon32.png"
  }
}
