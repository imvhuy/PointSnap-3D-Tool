# Chép file này thành .env.local (không commit) rồi điền token.
CVAT_URL=http://localhost:8080
# CVAT → góc phải (tài khoản) → Settings / hồ sơ → Access tokens → tạo token, tick "Read only", chép giá trị vào đây.
CVAT_TOKEN=
# QC_HOST=127.0.0.1
# QC_PORT=8766
# QC_HOME=.data
# QC_MAX_WARN_PER_100=5
# Tài khoản CVAT có vai trò QC, phân tách bằng dấu phẩy (để trống: admin của CVAT là QC, còn lại là annotator)
# QC_USERS=
