# Personal Access Token (Bearer) tao trong CVAT, khong dung token dang nhap cu.
CVAT_TOKEN=
# URL mo CVAT trong trinh duyet tren may ban.
CVAT_WEB_URL=http://localhost:8080
# Thu muc nuScenes tren may, dung dau / (bo trong de dung ./data/nuscenes).
NUSCENES_HOST_ROOT=
# Backend/web la hai dia chi cua CUNG server CVAT.
CVAT_URL=http://localhost:8080
CVAT_BACKEND_URL=http://cvat-server:8080
CVAT_DOCKER_NETWORK=cvat_cvat
CVAT_HOST=localhost
POINTSNAP_EXPORT_HOST_ROOT=./data/cvat
# Optional image tags for update/rollback; build CLI base before API.
POINTSNAP_CLI_IMAGE=pointsnap:0.1.0
POINTSNAP_API_IMAGE=pointsnap-api:0.1.0
